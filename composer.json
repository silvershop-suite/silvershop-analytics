{
    "name": "silvershop-suite/analytics",
    "description": "Catalog analytics for SilverShop: privacy-friendly product-view tracking and a most-viewed-products report, with a record() API that a search module can feed for search-term reports.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "analytics", "reports", "most-viewed"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/reports": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Analytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Analytics\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
